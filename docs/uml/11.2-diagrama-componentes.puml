@startuml
title Diagrama de Componentes — CONSTRUMOB MVP
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
actor "Usuário" as Usuario
node "Navegador Web" as Browser {
  component "Interface Thymeleaf" as Thymeleaf
  component "Bootstrap 5.3.3\nCSS responsivo" as Bootstrap
}
node "Aplicação Spring Boot 3.5.5" as App {
  component "Controllers" as Controllers
  component "Services" as Services
  package "Domínio" {
    component "Cliente / Profissional" as Usuarios
    component "Servico / PedidoServico" as Demandas
    component "Avaliacao / StatusPedido" as Avaliacoes
  }
  component "Repositories\nSpring Data JPA" as Repositories
}
database "MySQL 8.4" as MySQL
component "Docker Compose\nambiente local" as Docker
Usuario --> Thymeleaf : navega e envia formulários
Thymeleaf --> Bootstrap : utiliza estilos
Thymeleaf --> Controllers : requisições HTTP
Controllers --> Services : coordena casos de uso
Services --> Usuarios : regras de usuário
Services --> Demandas : publica, aceita e finaliza
Services --> Avaliacoes : registra avaliação
Services --> Repositories : persiste/consulta
Repositories --> MySQL : JDBC / JPA
Docker ..> MySQL : provisiona serviço local
@enduml
